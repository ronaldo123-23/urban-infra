# 실제 값은 .env.local 과 Vercel 환경변수에만 넣고 커밋하지 않는다. 비워 두면 해당 기능만 꺼진다.

# Meta oEmbed (instagram_oembed). 형식: <APP_ID>|<CLIENT_TOKEN>  (oEmbed Read 권한 심사 통과 후)
META_OEMBED_TOKEN=
META_GRAPH_VERSION=v21.0

# Claude API — 주장 추출과 판정. https://console.anthropic.com
ANTHROPIC_API_KEY=
# 선택: 기본값 claude-opus-5-5
ANTHROPIC_MODEL=

# 알리바바 클라우드 Model Studio (Qwen) — 규칙이 보류한 주장만 AI로 다시 판정 (lib/verify/aiJudge.ts). 비워 두면 꺼짐.
# https://modelstudio.console.alibabacloud.com  — 콘솔에서 "무료 토큰만 사용"을 켜 두면 무료분을 다 쓴 뒤 요금이 나가지 않는다.
DASHSCOPE_API_KEY=
# 키를 받은 지역 주소: 싱가포르(국제) https://dashscope-intl.aliyuncs.com/compatible-mode/v1
#   미국 https://dashscope-us.aliyuncs.com/compatible-mode/v1 · 중국 https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_BASE_URL=
# 콘솔 모델 목록의 이름 그대로. 무료 사용량이 있는 모델만 무료 (2026-11-23 기준 qwen-plus-character)
QWEN_MODEL=
# 이미지 분석 전용. 키의 지역에서 사용할 수 있는 이미지 입력 모델 이름 (예: qwen3-vl-plus)
# 무료 사용량과 초과 차단을 확인한 뒤 설정. 비워 두면 이미지 분석만 꺼짐.
QWEN_VISION_MODEL=

# 네이버 검색 API (뉴스) — 팩트체크 기사 검색. 둘 중 하나만 채우면 된다 (둘 다 있으면 API HUB 사용).
# (새 방식) 네이버 클라우드 NAVER API HUB: https://www.ncloud.com/product/applicationService/naverApiHub
NAVER_HUB_KEY_ID=
NAVER_HUB_KEY=
# (기존 방식) 네이버 개발자센터: https://developers.naver.com
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 국가통계포털 KOSIS 오픈API — 통계 대조. https://kosis.kr/openapi
KOSIS_API_KEY=
